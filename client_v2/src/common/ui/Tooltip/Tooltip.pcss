[data-scope='tooltip'][data-part='trigger'] {
    display: inline-flex;
    min-width: 0;
    overflow: hidden;
}

[data-scope='tooltip'][data-part='positioner'] {
    z-index: 1504;
}

[data-scope='tooltip'][data-part='content'] {
    position: relative;
    border-radius: 8px;
    box-shadow:
        0 8px 18px -6px var(--dropdown-box-shadow),
        0 12px 42px -4px var(--dropdown-box-shadow);
    outline: none;
}

/* Keeps the pointer on an interactive card while it crosses the gap to the
   trigger instead of handing the adjacent whole-row trigger its own hover.
   The gutter value comes from TOOLTIP_GUTTER in Tooltip.tsx. */
[data-scope='tooltip'][data-part='content']::before {
    content: '';
    position: absolute;
}

[data-scope='tooltip'][data-part='content'][data-side='bottom']::before,
[data-scope='tooltip'][data-part='content'][data-side='top']::before {
    right: 0;
    left: 0;
    height: var(--tooltip-gutter);
}

[data-scope='tooltip'][data-part='content'][data-side='bottom']::before {
    bottom: 100%;
}

[data-scope='tooltip'][data-part='content'][data-side='top']::before {
    top: 100%;
}
