/* The tooltip trigger is a flex item of the header cell, so it needs the same
   truncation-friendly sizing the bare label used to have.  `Tooltip` renders
   this wrapper even when it is disabled — then it carries no `data-part`
   attribute and the global trigger rules in `Tooltip.pcss` do not apply. */
.labelWrapper {
    min-width: 0;
    overflow: hidden;
}

.text {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Same menu padding the other tooltips in the app use. */
.tooltipContent {
    padding: 16px;
}
