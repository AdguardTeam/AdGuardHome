.root {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    min-width: 0;
    min-height: calc(100vh - 64px);
    padding: 24px;
    text-align: center;

    @media (min-width: 1200px) {
        min-height: 100vh;
    }
}

.face {
    color: var(--default-link);
}

.message {
    max-width: 508px;
    color: var(--default-main-text);
}
