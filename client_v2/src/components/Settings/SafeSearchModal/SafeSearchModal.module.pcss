.providersGrid {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 8px 0;
}

.providerRow {
    width: 100%;
    padding: 8px 0;
    border-radius: 8px;

    &:hover,
    &:focus-within {
        background-color: var(--page-background-additional);
    }
}

.checkboxFull {
    width: 100%;
}
