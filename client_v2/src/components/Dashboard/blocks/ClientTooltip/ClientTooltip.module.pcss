.tooltip {
    border-radius: 8px;
    padding: 8px 0 12px;
    min-width: 280px;
    box-shadow: 8px 8px 24px rgba(0, 0, 0, 0.1);
    cursor: default;
}

.tooltipTitle {
    padding: 8px 16px;
}

.tooltipRow {
    min-height: 24px;
    padding: 4px 16px;
    font-weight: var(--weight-semi-bold);
}

.tooltipValue {
    font-weight: var(--weight-regular);
}

.tooltipStatusValue {
    color: var(--default-error-link);
}
