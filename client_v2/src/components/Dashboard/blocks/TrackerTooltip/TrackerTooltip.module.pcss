.tooltip {
    border-radius: 8px;
    padding: 8px 0 12px;
    min-width: 280px;
    box-shadow: 8px 8px 24px rgba(0, 0, 0, 0.1);
    cursor: default;
}

.tooltipTitle {
    padding: 8px 16px;
}

.tooltipRow {
    display: flex;
    align-items: center;
    min-height: 24px;
    padding: 4px 16px;
    font-weight: var(--weight-semi-bold);
}

.tooltipLabel {
    margin-right: 2px;
}

.tooltipValue {
    font-weight: var(--weight-regular);
}

.tooltipLink {
    font-weight: var(--weight-regular);
    color: var(--default-link);
    text-decoration: underline;

    &:hover {
        color: var(--hovered-link);
    }
}

.tooltipLink {
    color: var(--default-link);
    text-decoration: underline;

    &:hover {
        color: var(--hovered-link);
    }
}
