.card {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    padding: 8px;
    border: 1px solid var(--default-item-divider);
    overflow: hidden;

    @media (min-width: 768px) {
        min-height: 384px;
    }
}

.cardHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 16px 24px;
}

.tableRows {
    flex: 1 1 auto;
    min-height: 0;
}

.rowDivider {
    display: none;
    padding: 16px 16px 24px;

    @media (min-width: 768px) {
        display: block;
    }

    &:before {
        content: '';
        display: block;
        width: 100%;
        height: 1px;
        background-color: var(--default-item-divider);
    }
}
