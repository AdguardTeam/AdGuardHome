.trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: none;
    border-radius: 6px;
    cursor: pointer;
    color: var(--default-description-text);
    transition: background-color 0.15s;
}

.overlay {
    min-width: 256px;
}

.menu {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--default-dropdown-menu-background);
    border-radius: 8px;
    box-shadow: var(--menu-box-shadow);
}

.menuItem {
    padding: 16px;
    cursor: pointer;
    color: var(--default-main-text);
    transition: background-color var(--t2);

    &:hover,
    &:focus {
        background-color: var(--hovered-dropdown-menu-background);
    }

    &:active {
        background-color: var(--pressed-dropdown-menu-background);
    }
}

.menuButton {
    display: block;
    width: 100%;
    border: none;
    background: none;
    text-align: left;
    font: inherit;
}

.actionsWrapper {
    display: flex;
    align-items: center;
}

.statusRed {
    color: var(--default-error-link);
}

.statusGreen {
    color: var(--default-link);
}
