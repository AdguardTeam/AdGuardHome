.tooltipText:not(:last-child) {
    margin-bottom: 16px;
}

.header {
    display: flex;
    align-items: center;
    padding-bottom: 16px;
}

.section {
    padding: 24px 16px 8px;
}

.certSection {
    padding: 8px 16px;
}

.certRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.certTitle {
    font-weight: var(--weight-semi-bold);
    font-size: 16px;
    color: var(--default-main-text);
}

.summaryLine {
    color: var(--default-description-text);
    font-size: 14px;
}

.setupRow {
    justify-content: flex-start;
}

/* Non-blocking note under a field — same tone as the wizard's step message. */
.fieldWarning {
    margin-top: 4px;
}
