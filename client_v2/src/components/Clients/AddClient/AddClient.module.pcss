.section {
    padding: 8px 16px;
    width: 100%;
}

.fieldGroup {
    width: 100%;
}

.fieldGroupInput {
    padding: 16px;
    width: 100%;
}

.fieldLabel {
    color: var(--default-main-text);
    margin-bottom: 4px;
}

.fieldDesc {
    color: var(--default-description-text);
    margin-bottom: 12px;

    a {
        color: var(--default-link);
    }
}

.containerOverride {
    padding-top: 0;
}
