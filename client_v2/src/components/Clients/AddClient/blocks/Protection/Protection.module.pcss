.containerOverride {
    padding-top: 0;
}

.checkboxRow {
    margin: 0 -16px;
    padding: 8px 16px;
    border-radius: 8px;

    &:hover,
    &:focus-within {
        background-color: var(--page-background-additional);
    }
}

.checkboxRowDisabled {
    &:hover,
    &:focus-within {
        background-color: transparent;
    }
}
